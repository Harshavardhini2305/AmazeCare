@{
    ViewData["Title"] = "Welcome to AmazeCare";
    Layout = null; // Landing page has its own layout (no navbar)
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmazeCare - Healthcare Management System</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/amazecare.css" />
</head>

<body>

    @* ── LANDING NAVBAR ──────────────────────────────────────── *@
    <nav class="amazecare-navbar navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-heartbeat"></i>
                Amaze<span>Care</span>
            </a>
            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#landingNav">
                <i class="fas fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse" id="landingNav">
                <ul class="navbar-nav ms-auto me-3">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#services">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact</a>
                    </li>
                </ul>
                <div class="d-flex gap-2">
                    <a asp-controller="Account" asp-action="Login"
                           class="btn-outline-custom btn-sm">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                           class="btn-primary-custom btn-sm">
                        <i class="fas fa-user-plus"></i> Register
                    </a>
                </div>
            </div>
        </div>
    </nav>

    @* ── HERO SECTION ─────────────────────────────────────────── *@
    <section class="hero-section" aria-label="Hero Section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 hero-content">
                    <p class="text-uppercase fw-600 mb-2"
                           style="color:var(--secondary);letter-spacing:2px;font-size:0.85rem;">
                        <i class="fas fa-plus-circle me-2"></i>
                        Healthcare Management
                    </p>
                    <h1 class="hero-title">
                        Your Health,
                        <span>Our Priority</span>
                    </h1>
                    <p class="hero-subtitle">
                        AmazeCare connects patients with expert doctors.
                        Book appointments, access medical records, and
                        get prescriptions — all in one place.
                    </p>
                    <div class="hero-buttons">
                        <a asp-controller="Account" asp-action="Register"
                               class="btn-primary-custom">
                            <i class="fas fa-user-plus"></i>
                            Get Started Free
                        </a>
                        <a asp-controller="Account" asp-action="Login"
                               class="btn-outline-custom">
                            <i class="fas fa-sign-in-alt"></i>
                            Login to Account
                        </a>
                    </div>

                    <!-- Quick Stats -->
                    <div class="row mt-4 g-3">
                        <div class="col-4">
                            <div class="text-center"
                                 style="background:rgba(255,255,255,0.1);
                                border-radius:var(--radius);padding:16px;">
                                <h3 style="color:var(--secondary);font-weight:800;margin:0;">48+</h3>
                                <small style="color:rgba(255,255,255,0.7);">Doctors</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-center"
                                 style="background:rgba(255,255,255,0.1);
                                border-radius:var(--radius);padding:16px;">
                                <h3 style="color:var(--secondary);font-weight:800;margin:0;">16+</h3>
                                <small style="color:rgba(255,255,255,0.7);">Specialties</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-center"
                                 style="background:rgba(255,255,255,0.1);
                                border-radius:var(--radius);padding:16px;">
                                <h3 style="color:var(--secondary);font-weight:800;margin:0;">24/7</h3>
                                <small style="color:rgba(255,255,255,0.7);">Support</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hero Image Side -->
                <div class="col-lg-6 d-none d-lg-flex justify-content-center">
                    <div style="position:relative;text-align:center;">
                        <!-- Big icon -->
                        <div style="width:320px;height:320px;
                            background:rgba(255,255,255,0.05);
                            border-radius:50%;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            border:2px solid rgba(255,255,255,0.1);">
                            <i class="fas fa-hospital"
                               style="font-size:8rem;color:rgba(255,255,255,0.15);"></i>
                        </div>
                        <!-- Floating cards -->
                        <div style="position:absolute;top:20px;left:-20px;
                            background:var(--white);border-radius:var(--radius);
                            padding:12px 16px;box-shadow:var(--shadow-md);">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div style="width:36px;height:36px;background:#d1fae5;
                                    border-radius:8px;display:flex;
                                    align-items:center;justify-content:center;">
                                    <i class="fas fa-calendar-check"
                                       style="color:var(--secondary);"></i>
                                </div>
                                <div>
                                    <p style="margin:0;font-size:0.7rem;color:var(--gray);">
                                        Appointment
                                    </p>
                                    <p style="margin:0;font-size:0.85rem;
                                        font-weight:700;color:var(--dark);">
                                        Confirmed!
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div style="position:absolute;bottom:40px;right:-20px;
                            background:var(--white);border-radius:var(--radius);
                            padding:12px 16px;box-shadow:var(--shadow-md);">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div style="width:36px;height:36px;background:var(--primary-light);
                                    border-radius:8px;display:flex;
                                    align-items:center;justify-content:center;">
                                    <i class="fas fa-prescription"
                                       style="color:var(--primary);"></i>
                                </div>
                                <div>
                                    <p style="margin:0;font-size:0.7rem;color:var(--gray);">
                                        Prescription
                                    </p>
                                    <p style="margin:0;font-size:0.85rem;
                                        font-weight:700;color:var(--dark);">
                                        Ready!
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── FEATURES SECTION ──────────────────────────────────────── *@
    <section class="features-section" id="features" aria-label="Features">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-800" style="font-size:2.2rem;color:var(--dark);">
                    Why Choose <span style="color:var(--primary);">AmazeCare?</span>
                </h2>
                <p style="color:var(--gray);max-width:500px;margin:0 auto;">
                    Everything you need for complete healthcare management
                </p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon blue">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <h4>Easy Booking</h4>
                        <p>Book appointments with specialists in just a few clicks</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon green">
                            <i class="fas fa-file-medical"></i>
                        </div>
                        <h4>Medical Records</h4>
                        <p>Access your complete medical history anytime, anywhere</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon orange">
                            <i class="fas fa-prescription"></i>
                        </div>
                        <h4>Digital Prescriptions</h4>
                        <p>View your prescriptions with dosage details online</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon purple">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h4>Secure & Private</h4>
                        <p>Your health data is protected with enterprise security</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── SERVICES SECTION ──────────────────────────────────────── *@
    <section id="services" aria-label="Services"
             style="padding:80px 0;background:var(--light);">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-800" style="font-size:2.2rem;color:var(--dark);">
                    Our <span style="color:var(--secondary);">Services</span>
                </h2>
            </div>

            <div class="row g-4">
                <!-- Patient Services -->
                <div class="col-md-4">
                    <div class="amazecare-card h-100">
                        <div class="card-header blue">
                            <span>
                                <i class="fas fa-user me-2"></i>
                                For Patients
                            </span>
                        </div>
                        <div class="card-body">
                            <ul style="list-style:none;padding:0;">
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Online appointment booking
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Search doctors by specialty
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    View prescriptions online
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Access medical history
                                </li>
                                <li class="py-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Reschedule appointments
                                </li>
                            </ul>
                            <a asp-controller="Account" asp-action="Register"
                                   class="btn-primary-custom mt-3 w-100 justify-content-center">
                                Register as Patient
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Doctor Services -->
                <div class="col-md-4">
                    <div class="amazecare-card h-100">
                        <div class="card-header green">
                            <span>
                                <i class="fas fa-user-md me-2"></i>
                                For Doctors
                            </span>
                        </div>
                        <div class="card-body">
                            <ul style="list-style:none;padding:0;">
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    View appointment schedule
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Add consultation details
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Prescribe medications
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Add medical records
                                </li>
                                <li class="py-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Confirm/Cancel appointments
                                </li>
                            </ul>
                            <a asp-controller="Account" asp-action="Login"
                                   class="btn-success-custom mt-3 w-100 justify-content-center">
                                Doctor Login
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Admin Services -->
                <div class="col-md-4">
                    <div class="amazecare-card h-100">
                        <div class="card-header">
                            <span>
                                <i class="fas fa-cog me-2"></i>
                                For Admin
                            </span>
                        </div>
                        <div class="card-body">
                            <ul style="list-style:none;padding:0;">
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Manage doctors & patients
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Monitor all appointments
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Add/Edit/Delete doctors
                                </li>
                                <li class="py-2 border-bottom">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Generate reports
                                </li>
                                <li class="py-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    Full system control
                                </li>
                            </ul>
                            <a asp-controller="Account" asp-action="Login"
                                   class="btn-primary-custom mt-3 w-100 justify-content-center"
                                   style="background:var(--dark);">
                                Admin Login
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── CONTACT SECTION ───────────────────────────────────────── *@
    <section id="contact" aria-label="Contact"
             style="padding:80px 0;background:var(--dark);">
        <div class="container text-center">
            <h2 class="fw-800 text-white mb-3" style="font-size:2rem;">
                Ready to Get <span style="color:var(--secondary);">Started?</span>
            </h2>
            <p style="color:rgba(255,255,255,0.7);margin-bottom:30px;">
                Join thousands of patients and doctors using AmazeCare
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Account" asp-action="Register"
                       class="btn-primary-custom">
                    <i class="fas fa-user-plus"></i> Register Now — It's Free
                </a>
                <a asp-controller="Account" asp-action="Login"
                       class="btn-outline-custom">
                    <i class="fas fa-sign-in-alt"></i> Already have an account?
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="amazecare-footer">
        <p>
            &copy; @DateTime.Now.Year
            <strong>AmazeCare</strong> — Healthcare Management System.
            All Rights Reserved.
        </p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
