<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AmazeCare</title>

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- AmazeCare Custom CSS -->
    <link rel="stylesheet" href="~/css/amazecare.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @{
        // Get session values for navbar
        var role = Context.Session.GetString("UserRole");
        var userName = Context.Session.GetString("UserName");
        var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("JwtToken"));
    }

    @* ── NAVBAR ─────────────────────────────────────────────── *@
    @if (isLoggedIn)
    {
        <nav class="amazecare-navbar navbar navbar-expand-lg">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-heartbeat"></i>
                    Amaze<span>Care</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMenu"
                        aria-controls="navMenu" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="fas fa-bars text-white"></i>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @* Patient Navigation *@
                        @if (role == "Patient")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="Doctors">
                                    <i class="fas fa-user-md me-1"></i> Find Doctors
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="MyAppointments">
                                    <i class="fas fa-calendar-alt me-1"></i> My Appointments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="MedicalHistory">
                                    <i class="fas fa-file-medical me-1"></i> Medical History
                                </a>
                            </li>
                        }

                        @* Doctor Navigation *@
                        @if (role == "Doctor")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Upcoming">
                                    <i class="fas fa-clock me-1"></i> Upcoming
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Completed">
                                    <i class="fas fa-check-circle me-1"></i> Completed
                                </a>
                            </li>
                        }

                        @* Admin Navigation *@
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Doctors">
                                    <i class="fas fa-user-md me-1"></i> Doctors
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Patients">
                                    <i class="fas fa-users me-1"></i> Patients
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Appointments">
                                    <i class="fas fa-calendar-alt me-1"></i> Appointments
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- User Info + Logout -->
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-white">
                            <small class="d-block opacity-75">
                                <i class="fas fa-circle text-success me-1" style="font-size:8px;"></i>
                                @role
                            </small>
                            <span class="fw-600" style="font-size:0.9rem;">
                                @userName
                            </span>
                        </div>
                        <a asp-controller="Account" asp-action="Logout"
                               class="btn-logout">
                            <i class="fas fa-sign-out-alt me-1"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    }

    @* ── MAIN CONTENT ────────────────────────────────────────── *@
    <main>
        @* Show success/error messages from TempData *@
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert-custom alert-success-custom">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert-custom alert-danger-custom">
                    <i class="fas fa-exclamation-circle"></i>
                    @TempData["Error"]
                </div>
            </div>
        }

        @RenderBody()
    </main>

    @* ── FOOTER ──────────────────────────────────────────────── *@
    <footer class="amazecare-footer">
        <p>
            &copy; @DateTime.Now.Year
            <strong>AmazeCare</strong> — Healthcare Management System.
            All Rights Reserved.
        </p>
    </footer>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- AmazeCare Custom JS -->
    <script src="~/js/amazecare.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
